# Copy to .env and adjust. Never commit real secrets.

# --- Runtime -----------------------------------------------------------
PRIMUS_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PRIMUS_SECRET_KEY=change-me-to-a-long-random-string
PRIMUS_DATABASE_URL=sqlite:///dev.db

# --- Registration / auth ----------------------------------------------
PRIMUS_ALLOW_REGISTRATION=1
PRIMUS_SESSION_DAYS=14
PRIMUS_PASSWORD_MIN_LENGTH=8
# Set to 1 only when serving over HTTPS:
PRIMUS_COOKIE_SECURE=0

# --- Checker -----------------------------------------------------------
PRIMUS_DEFAULT_TIMEOUT=10
PRIMUS_MAX_TIMEOUT=60
PRIMUS_MIN_INTERVAL=30
PRIMUS_MAX_INTERVAL=86400
PRIMUS_CHECK_RETRIES=1
PRIMUS_RETRY_DELAY=2
# An incident opens after this many consecutive failures.
PRIMUS_FAILURE_THRESHOLD=2
# Allow monitoring private/internal addresses (SSRF guard off). Default: 0.
PRIMUS_ALLOW_PRIVATE_TARGETS=0

# --- Scheduler ---------------------------------------------------------
# Run the in-process scheduler (single-node deployments).
PRIMUS_ENABLE_SCHEDULER=1
PRIMUS_SCHEDULER_INTERVAL=5
PRIMUS_WORKER_THREADS=8
